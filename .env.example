# Documentation only. The Ansible installer creates .env with fresh secrets.
# Never use this file's empty values as production credentials.
POSTGRES_USER=opscenter
POSTGRES_DB=opscenter
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
DOCKER_GID=
DATA_ROOT=/var/lib/ops-center
OPS_LOCAL_HOSTNAME=ops-host
TZ=UTC
BIND_ADDRESS=127.0.0.1
PROXY_HTTP_PORT=8080
IMAGE_PREFIX=ops-center
IMAGE_TAG=local

# Optional integrations. Lists use JSON, enclosed in single quotes in .env.
CAMERAS='[]'
STREAMED_CAMERAS='[]'
CAMERA_WATCHDOG_TARGETS='[]'
GO2RTC_URL=
UNIFI_URL=
UNIFI_VERIFY_TLS=true
WG_EASY_URL=
TRAFFIC_CADDY_HOST=
TRAFFIC_NPM_HOST=
TRAFFIC_CADDY_LOG=/var/log/caddy/access.log
TRAFFIC_NPM_LOG_DIR=/var/log/nginx-proxy-manager
TALK_BACKEND_URL=
TALK_MEMORY_BINDINGS='[]'
LOKI_EXTERNAL_URL=

# Optional HA services. Generate a fresh cluster with scripts/ha/generate.py; see docs/ha.md.
DATABASE_HOST=postgres
REDIS_SENTINELS=
REDIS_NODES=redis
REDIS_MASTER_NAME=ops-center-redis
PATRONI_NODES=
PATRONI_RESTAPI_PASSWORD=
POSTGRES_VIP=
