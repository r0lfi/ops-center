# Documentation only. The Ansible installer creates .env with fresh secrets.
# Never use this file's empty values as production credentials.
POSTGRES_USER=opscenter
POSTGRES_DB=opscenter
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
DOCKER_GID=
DATA_ROOT=/var/lib/ops-center
OPS_LOCAL_HOSTNAME=ops-host
TZ=UTC
BIND_ADDRESS=127.0.0.1

# Sessions. Access tokens live only in browser memory; an HttpOnly refresh
# cookie renews them. "Remember me" resumes idle sessions within
# SESSION_REMEMBER_IDLE_DAYS, never past SESSION_REMEMBER_ABSOLUTE_DAYS.
ACCESS_TOKEN_EXPIRE_MINUTES=15
SESSION_REMEMBER_IDLE_DAYS=30
SESSION_REMEMBER_ABSOLUTE_DAYS=90
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_HOURS=72
# Keep true behind HTTPS. Set false only when browsers reach Ops Center over plain HTTP.
SESSION_COOKIE_SECURE=true
REAUTH_MAX_AGE_SECONDS=300

# Monitoring. Optional JSON map: Prometheus cAdvisor instance -> inventory host
# UUID (targets with a host_id label do not need it). Nodes without a local
# Prometheus service can point PROMETHEUS_QUERY_URL at a reachable shared one.
MONITORING_CONTAINER_TARGETS='{}'
PROMETHEUS_QUERY_URL=http://prometheus:9090

PROXY_HTTP_PORT=8080
# Application images. Published releases: ghcr.io/r0lfi/ops-center/<component>.
# Pin a version in production (IMAGE_TAG=0.1.0); `latest` moves with every
# stable release. Images built from this checkout use IMAGE_PREFIX=ops-center
# and IMAGE_TAG=local (the installer's default, ops_build_images=true).
IMAGE_PREFIX=ghcr.io/r0lfi/ops-center
IMAGE_TAG=0.1.0

# Optional integrations. Lists use JSON, enclosed in single quotes in .env.
CAMERAS='[]'
STREAMED_CAMERAS='[]'
CAMERA_WATCHDOG_TARGETS='[]'
GO2RTC_URL=
UNIFI_URL=
UNIFI_VERIFY_TLS=true
WIREGUARD_URL=
WIREGUARD_PASSWORD_PATH=integrations/wireguard-admin-password
# Traffic sources/trust/retention: Settings -> Traffic Map & authentication.
TALK_NOTIFICATIONS_ENABLED=false
TALK_BACKEND_URL=
TALK_MEMORY_BINDINGS='[]'
LOKI_EXTERNAL_URL=

# Optional HA services. Generate a fresh cluster with scripts/ha/generate.py; see docs/ha.md.
DATABASE_HOST=postgres
REDIS_SENTINELS=
REDIS_NODES=redis
REDIS_MASTER_NAME=ops-center-redis
PATRONI_NODES=
PATRONI_RESTAPI_PASSWORD=
POSTGRES_VIP=

# Optional upstream overrides (normally use Compose service discovery).
LOKI_HEALTH_URL=http://loki:3100/ready
LOKI_API_URL=http://loki:3100
PROMETHEUS_API_URL=http://prometheus:9090
PATRONI_REST_PORT=8008
PATRONI_RESTAPI_USERNAME=patroni_admin

# Optional standard MCP endpoint; configure your own HTTPS origin.
MCP_PUBLIC_URL=
MCP_ALLOWED_ORIGINS=[]

# AI Traffic Monitor. AI_TRAFFIC_INGEST_TOKEN is ops-api's secret (same value on
# both nodes; openssl rand -hex 32). The collector on each node gets only its own
# token, HMAC-SHA256(secret, OPS_LOCAL_HOSTNAME), so it cannot speak for another node:
#   printf %s "$OPS_LOCAL_HOSTNAME" | openssl dgst -sha256 -hmac "$AI_TRAFFIC_INGEST_TOKEN" | awk '{print $NF}'
# Empty = collector idles and coverage shows "missing".
AI_TRAFFIC_INGEST_TOKEN=
AI_TRAFFIC_COLLECTOR_TOKEN=
